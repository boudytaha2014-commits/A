<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>NeonPulse™ | متجر الإضاءة الذكية المحيطية</title>
    <style>
        /* ==========================================
           1. RESET & BASE STYLES (تنسيقات الخطوط والأساسيات)
           ========================================== */
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            scroll-behavior: smooth;
        }

        body {
            background-color: #0b0c10;
            color: #ffffff;
            line-height: 1.7;
            overflow-x: hidden;
        }

        .container {
            width: 90%;
            max-width: 1100px;
            margin: 0 auto;
            padding: 20px 0;
        }

        /* ==========================================
           2. HEADER SECTION (رأس الصفحة والشعار)
           ========================================== */
        header {
            background-color: rgba(11, 12, 16, 0.95);
            border-bottom: 1px solid #1f2833;
            position: sticky;
            top: 0;
            z-index: 1000;
            backdrop-filter: blur(10px);
        }

        .header-container {
            display: block;
            text-align: center;
            padding: 10px 0;
        }

        .logo {
            font-size: 28px;
            font-weight: 800;
            color: #66fcf1;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            text-decoration: none;
        }

        .logo span {
            color: #45f3ff;
            text-shadow: 0 0 10px rgba(69, 243, 255, 0.5);
        }

        /* ==========================================
           3. HERO SECTION (الواجهة الرئيسية وعرض العرض)
           ========================================== */
        .hero {
            padding: 60px 0 80px 0;
            text-align: center;
            background: radial-gradient(circle at top, #1f2833 0%, #0b0c10 80%);
        }

        .promo-badge {
            background: linear-gradient(135deg, #66fcf1 0%, #45f3ff 100%);
            color: #0b0c10;
            padding: 6px 20px;
            border-radius: 50px;
            font-size: 14px;
            font-weight: bold;
            display: inline-block;
            margin-bottom: 25px;
            box-shadow: 0 0 15px rgba(102, 252, 241, 0.4);
            animation: pulse 2s infinite;
        }

        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.05); }
            100% { transform: scale(1); }
        }

        .hero h1 {
            font-size: 42px;
            font-weight: 900;
            margin-bottom: 20px;
            line-height: 1.4;
        }

        .hero h1 span {
            color: #66fcf1;
            background: linear-gradient(135deg, #66fcf1, #45f3ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
        }

        .hero p {
            font-size: 19px;
            color: #c5a059;
            color: #a4b3c6;
            max-width: 700px;
            margin: 0 auto 35px auto;
        }

        .cta-button {
            display: inline-block;
            background: linear-gradient(135deg, #45f3ff 0%, #1f2833 100%);
            background: #45f3ff;
            color: #0b0c10;
            padding: 18px 45px;
            font-size: 20px;
            font-weight: bold;
            text-decoration: none;
            border-radius: 50px;
            box-shadow: 0 5px 25px rgba(69, 243, 255, 0.4);
            transition: all 0.3s ease;
            border: none;
            cursor: pointer;
        }

        .cta-button:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 30px rgba(69, 243, 255, 0.7);
            background: #66fcf1;
        }

        /* ==========================================
           4. PRODUCT IMAGE SHOWCASE (صورة المنتج والتأثير البصري)
           ========================================== */
        .showcase-box {
            margin-top: 50px;
            position: relative;
        }

        .main-product-img {
            width: 100%;
            max-width: 600px;
            height: 380px;
            margin: 0 auto;
            background: linear-gradient(135deg, #1f2833 0%, #0b0c10 100%);
            border: 3px solid #45f3ff;
            border-radius: 20px;
            box-shadow: 0 15px 40px rgba(0,0,0,0.6), 0 0 30px rgba(69, 243, 255, 0.2);
            position: relative;
        }

        .main-product-img::after {
            content: "📸 ضع رابط صورة منتجك هنا لاحقاً";
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            color: #66fcf1;
            font-size: 18px;
            font-weight: bold;
        }

        /* ==========================================
           5. FEATURES SECTION (سيكشن مميزات المنتج الذكي)
           ========================================== */
        .features-section {
            background-color: #12141c;
            padding: 80px 0;
            border-top: 1px solid #1f2833;
            border-bottom: 1px solid #1f2833;
        }

        .section-headline {
            text-align: center;
            font-size: 32px;
            font-weight: 800;
            margin-bottom: 50px;
            color: #ffffff;
        }

        .section-headline::after {
            content: '';
            display: block;
            width: 80px;
            height: 4px;
            background: linear-gradient(90deg, #45f3ff, #66fcf1);
            margin: 15px auto 0 auto;
            border-radius: 10px;
        }

        .feature-card {
            display: block;
            background-color: #1f2833;
            padding: 30px;
            border-radius: 15px;
            margin-bottom: 25px;
            border-right: 5px solid #45f3ff;
            box-shadow: 0 5px 15px rgba(0,0,0,0.2);
            transition: transform 0.3s ease;
        }

        .feature-card:hover {
            transform: scale(1.02);
        }

        .feature-card h3 {
            font-size: 22px;
            color: #45f3ff;
            margin-bottom: 12px;
        }

        .feature-card p {
            color: #c5a059;
            color: #a4b3c6;
            font-size: 16px;
        }

        /* ==========================================
           6. TESTIMONIALS & REVIEWS (آراء وتقييمات العملاء لزيادة الثقة)
           ========================================== */
        .reviews-section {
            padding: 80px 0;
            background-color: #0b0c10;
        }

        .review-box {
            background-color: #12141c;
            padding: 25px;
            border-radius: 12px;
            margin-bottom: 20px;
            border: 1px solid #1f2833;
        }

        .stars-container {
            color: #ffc107;
            font-size: 20px;
            margin-bottom: 10px;
        }

        .customer-name {
            font-weight: 700;
            color: #66fcf1;
            font-size: 16px;
            margin-bottom: 6px;
        }

        .review-comment {
            color: #cdfffb;
            color: #94a3b8;
            font-size: 15px;
        }

        /* ==========================================
           7. CHECKOUT / ORDER FORM (فورم الدفع عند الاستلام الأسطوري)
           ========================================== */
        .checkout-section {
            padding: 80px 0;
            background: linear-gradient(180deg, #0b0c10 0%, #12141c 100%);
        }

        .checkout-container {
            max-width: 600px;
            margin: 0 auto;
            background-color: #1f2833;
            padding: 40px 30px;
            border-radius: 20px;
            border: 2px solid #45f3ff;
            box-shadow: 0 15px 35px rgba(0,0,0,0.5);
        }

        .price-wrapper {
            text-align: center;
            margin-bottom: 30px;
            background-color: #0b0c10;
            padding: 20px;
            border-radius: 12px;
            border: 1px dashed #45f3ff;
        }

        .original-price {
            text-decoration: line-through;
            color: #ff4a4a;
            font-size: 20px;
            margin-left: 15px;
        }

        .discount-price {
            color: #2ecc71;
            font-size: 36px;
            font-weight: 900;
            text-shadow: 0 0 10px rgba(46, 204, 113, 0.3);
        }

        .shipping-info {
            color: #a4b3c6;
            font-size: 14px;
            margin-top: 8px;
        }

        .input-group {
            margin-bottom: 22px;
            text-align: right;
        }

        .input-group label {
            display: block;
            margin-bottom: 10px;
            color: #66fcf1;
            font-size: 16px;
            font-weight: 600;
        }

        .input-group input, .input-group select {
            width: 100%;
            padding: 14px 18px;
            border-radius: 10px;
            border: 1px solid #45f3ff;
            background-color: #0b0c10;
            color: #ffffff;
            font-size: 16px;
            outline: none;
            transition: all 0.3s ease;
        }

        .input-group input:focus, .input-group select:focus {
            border-color: #66fcf1;
            box-shadow: 0 0 10px rgba(102, 252, 241, 0.5);
        }

        .submit-order-btn {
            width: 100%;
            background: linear-gradient(135deg, #2ecc71 0%, #27ae60 100%);
            color: #ffffff;
            padding: 18px;
            font-size: 22px;
            font-weight: 800;
            border: none;
            border-radius: 50px;
            cursor: pointer;
            box-shadow: 0 5px 20px rgba(46, 204, 113, 0.4);
            transition: all 0.3s ease;
            margin-top: 15px;
        }

        .submit-order-btn:hover {
            transform: translateY(-3px);
            box-shadow: 0 8px 25px rgba(46, 204, 113, 0.7);
            background: #2ecc71;
        }

        /* ==========================================
           8. FOOTER SECTION (حقوق الملكية والنهاية)
           ========================================== */
        footer {
            text-align: center;
            padding: 40px 20px;
            color: #c5a059;
            color: #6272a4;
            font-size: 15px;
            border-top: 1px solid #1f2833;
            background-color: #0b0c10;
        }

        /* ==========================================
           9. MULTI-COLUMN LAYOUT ON LARGE SCREENS (تنسيق الشاشات الكبيرة)
           ========================================== */
        @media (min-width: 768px) {
            .features-grid {
                display: block;
            }
            .feature-card {
                display: inline-block;
                width: 31%;
                margin-left: 2%;
                vertical-align: top;
                min-height: 180px;
            }
            .feature-card:last-child {
                margin-left: 0;
            }
        }
    </style>
</head>
<body>

    <!-- الهيدر الاستايلش -->
    <header>
        <div class="container header-container">
            <a href="#" class="logo">Neon<span>Pulse</span></a>
        </div>
    </header>

    <!-- واجهة المتجر الرئيسية -->
    <section class="hero">
        <div class="container">
            <div class="promo-badge">⚡ عرض حصري: خصم 40% ينتهي الليلة!</div>
            <h1>حوّل غرفتك إلى ستوديو ألعاب أسطوري <br>مع <span>إضاءة الـ LED المحيطية الذكية</span></h1>
            <p>انغمس في تجربة بصرية فائقة الجمال متزامنة بالكامل مع شاشتك وألعابك المفضلة. تحكم متطور بمليارات الألوان من هاتفك لتصنع الأجواء التي تبحث عنها.</p>
            
            <a href="#order-form-section" class="cta-button">احصل عليها الآن والدفع عند الاستلام</a>

            <div class="showcase-box">
                <div class="main-product-img"></div>
            </div>
        </div>
    </section>

    <!-- سيكشن مميزات المنتج الفنية -->
    <section class="features-section">
        <div class="container">
            <h2 class="section-headline">مواصفات تضمن لك التجربة الأفضل</h2>
            <div class="features-grid">
                <div class="feature-card">
                    <h3>🌈 16 مليون لون ذكي</h3>
                    <p>تكنولوجيا RGBIC متطورة تمكنك من عرض ألوان متعددة في نفس الوقت على شريط واحد لإنتاج تأثيرات متحركة ومبهرة.</p>
                </div>
                <div class="feature-card">
                    <h3>📲 تحكم كامل عبر التطبيق</h3>
                    <p>يتصل مباشرة بالبلوتوث والواي فاي عبر تطبيق مخصص لتغيير الأوضاع والسطوع، وضبط مؤقت للتشغيل التلقائي.</p>
                </div>
                <div class="feature-card">
                    <h3>🎵 حساس صوتي تفاعلي</h3>
                    <p>ميكروفون مدمج ذكي يستشعر الأصوات والموسيقى المحيطة، لتتراقص الإضاءة وتتناغم مع ضربات ألعاب الـ FPS والجيمنج.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- سيكشن تقييمات المشترين وثقة العملاء -->
    <section class="reviews-section">
        <div class="container">
            <h2 class="section-headline">آراء الكوميونيتي والجيمنج في مصر</h2>
            
            <div class="review-box">
                <div class="stars-container">★★★★★</div>
                <div class="customer-name">مروان أ. - الإسكندرية</div>
                <div class="review-comment">"بصراحة الإضاءة نقلت السيت أب بتاعي لمكان تاني خالص، وتفاعل الألوان مع صوت اللعبة سريع جداً وبدون أي تأخير. أنصح بيه جداً."</div>
            </div>

            <div class="review-box">
                <div class="stars-container">★★★★★</div>
                <div class="customer-name">يوسف م. - القاهرة</div>
                <div class="review-comment">"التقفيل والخامة ممتازة والتطبيق فيه أنماط إضاءة جاهزة كتير جداً مريحة للعين وقت الجيمنج بليل. والتوصيل أخد يومين بس."</div>
            </div>
        </div>
    </section>

    <!-- سيكشن الشراء السريع -->
    <section class="checkout-section" id="order-form-section">
        <div class="container">
            <h2 class="section-headline">أدخل بياناتك لإتمام الطلب</h2>
            
            <div class="checkout-container">
                <div class="price-wrapper">
                    <span class="original-price">650 ج.م</span>
                    <span class="discount-price">390 ج.م</span>
                    <p class="shipping-info">💵 الدفع عند الاستلام بعد المعاينة + شحن سريع لكل المحافظات</p>
                </div>

                <!-- استبدل الرابط أدناه برابط Formspree الخاص بك لتستقبل الطلبات على الإيميل -->
                <form action="https://formspree.io/f/YOUR_FORM_ID_HERE" method="POST">
                    
                    <div class="input-group">
                        <label for="full-name">الاسم بالكامل:</label>
                        <input type="text" id="full-name" name="name" placeholder="اكتب اسمك الثلاثي" required>
                    </div>

                    <div class="input-group">
                        <label for="phone-number">رقم الموبايل:</label>
                        <input type="tel" id="phone-number" name="phone" placeholder="رقم متاح للتواصل عبر الواتساب أو الاتصال" required>
                    </div>

                    <div class="input-group">
                        <label for="city">المحافظة:</label>
                        <select id="city" name="governorate" required>
                            <option value="">-- اختر المحافظة --</option>
                            <option value="Cairo">القاهرة</option>
                            <option value="Giza">الجيزة</option>
                            <option value="Alexandria">الإسكندرية</option>
                            <option value="Qalyubia">القليوبية</option>
                            <option value="Gharbia">الغربية</option>
                            <option value="Dakahlia">الدقهلية</option>
                            <option value="Other">محافظة أخرى</option>
                        </select>
                    </div>

                    <div class="input-group">
                        <label for="home-address">العنوان بالتفصيل:</label>
                        <input type="text" id="home-address" name="address" placeholder="اسم الشارع، رقم البيت أو العمارة، رقم الشقة" required>
                    </div>

                    <button type="submit" class="submit-order-btn">🚀 تأكيد الشراء وشحن مجاني اليوم</button>
                </form>
            </div>
        </div>
    </section>

    <!-- الفوتر والنهاية -->
    <footer>
        <div class="container">
            <p>جميع الحقوق محفوظة © 2026 NeonPulse Store | منصة تجارة إلكترونية آمنة</p>
        </div>
    </footer>

</body>
</html>

